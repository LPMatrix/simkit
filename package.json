{
  "name": "simkit",
  "version": "0.15.0",
  "description": "Build the rules. SimKit runs the world. A TypeScript simulation runtime and domain SDK for systemic worlds.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "example": "tsx examples/lagos-life-mini.ts",
    "server": "tsx server/main.ts",
    "typecheck": "tsc --noEmit && tsx --eval \"import('typescript').then(async () => {})\"",
    "typecheck:all": "npx tsc --noEmit -p tsconfig.all.json",
    "spike": "tsx experiments/run.ts",
    "simulate": "tsx src/cli.ts simulate"
  },
  "keywords": [
    "simulation",
    "simulation-runtime",
    "game",
    "economy",
    "agent-based",
    "deterministic",
    "replay",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "js-yaml": "^5.4.3"
  },
  "bin": {
    "simkit": "./dist/cli.js"
  }
}
